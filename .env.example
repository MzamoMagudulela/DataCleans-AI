# Environment Configuration for DataCleans AI
APP_ENV=development
DEBUG=True

# SQLite Database Location
DATABASE_URL=sqlite:///data/datacleans.db

# Storage Directories
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLES_DATA_DIR=data/samples
REPORTS_DIR=reports

# App Settings
MAX_UPLOAD_SIZE_MB=50
DEFAULT_SAMPLE_ROWS=1000
